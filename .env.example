# ==============================================================================
# KAHNEMANGUARD: A DUAL-PROCESS FAST-SLOW ARCHITECTURE FOR HIGH-THROUGHPUT LLM GUARDRAILS
# UIT Graduation Thesis Configuration
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. LOCAL MODEL HUB & ONNX ARTIFACT PATHS
# ------------------------------------------------------------------------------
HUB_DIR=C:\Hub\Models\kahneman_guard
USE_LOCAL_ONNX=false

# Tier 1: ModernBERT Dense Engine
DENSE_ONNX_PATH=C:\Hub\Models\kahneman_guard\dense_guard\kahnemanguard_modernbert_int8.onnx
DENSE_TOKENIZER_ID=C:\Hub\Models\kahneman_guard\dense_guard
DENSE_TEMPERATURE=1.9665

# Tier 1: ModernBERT Discrete Diffusion Engine (djev)
DIFFUSION_ONNX_PATH=C:\Hub\Models\kahneman_guard\diff_guard\kahnemanguard_diffusion_int8.onnx
DIFFUSION_TOKENIZER_ID=C:\Hub\Models\kahneman_guard\diff_guard
DIFFUSION_TEMPERATURE=1.3358

# Tier 1: ModernBERT Diffusion + RLCD Engine
DIFFUSION_RLCD_ONNX_PATH=C:\Hub\Models\kahneman_guard\diff_rlcd_guard\kahnemanguard_diffusion_rlcd_int8.onnx
DIFFUSION_RLCD_TOKENIZER_ID=C:\Hub\Models\kahneman_guard\diff_rlcd_guard
DIFFUSION_RLCD_TEMPERATURE=1.9460

# Tier 2: System-Two Deep Loop Model (Llama-Guard-3-1B GGUF)
TIER2_GGUF_PATH=C:\Hub\Models\Llama-Guard-3-1B.Q4_K_M.gguf

# ------------------------------------------------------------------------------
# 2. PROXY GATEWAY SETTINGS
# ------------------------------------------------------------------------------
PROXY_HOST=0.0.0.0
PROXY_PORT=5950
LOG_LEVEL=info

# ------------------------------------------------------------------------------
# 3. MICROSERVICE BACKENDS (OPTIONAL SERVICE PORTS)
# ------------------------------------------------------------------------------
# Model Tier 1 Microservice (Laya Typed-Decisions ONNX)
TIER1_URL=http://localhost:5816
TIER1_ENDPOINT=/v1/system_one
TIER1_TIMEOUT_MS=5000
TIER1_MOCK_MODE=false

# Model Tier 2 Microservice (Llama-Guard-3-1B llama-server)
TIER2_URL=http://localhost:5817
TIER2_ENDPOINT=/v1/chat/completions
TIER2_TIMEOUT_MS=15000
TIER2_MOCK_MODE=false
TIER2_MODEL_NAME=Llama-Guard-3-1B

# Optional Upstream Target LLM (for proxy forwarding safe requests; default mock)
UPSTREAM_LLM_URL=http://localhost:5814
UPSTREAM_LLM_MOCK=true

# ------------------------------------------------------------------------------
# 4. CONFIDENCE ROUTING & DECISION THRESHOLDS
# ------------------------------------------------------------------------------
DEFAULT_ROUTING_MODE=dual_process
DEFAULT_VARIANT=dense
ROUTER_TAU_SAFE=0.80
ROUTER_TAU_UNSAFE=0.80

# ------------------------------------------------------------------------------
# 5. EVALUATION & BENCHMARK CONFIGURATION
# ------------------------------------------------------------------------------
BENCHMARK_BATCH_SIZE=20
BENCHMARK_RANDOM_SEED=42
BENCHMARK_CACHE_DIR=data/benchmarks
DATASET_JAILBREAKBENCH=data/benchmarks/jailbreakbench.jsonl
DATASET_TOXICCHAT=data/benchmarks/toxicchat_test.jsonl
DATASET_BEAVERTAILS=data/benchmarks/beavertails_test.jsonl
DATASET_XSTEST=data/benchmarks/xstest_benign.jsonl
